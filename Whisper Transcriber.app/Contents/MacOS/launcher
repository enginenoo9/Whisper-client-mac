#!/bin/bash
#
# Whisper Transcriber — launcher
#
# Resolves the bundle location and hands off to bootstrap.py, which does
# all first-run setup (private venv, installing mlx-whisper) and then
# launches the app. All of that logic lives in Python now — this script
# just picks which Python interpreter runs it:
#
#   - If this .app was built with build-dmg.sh, it carries its own
#     Python.framework (Contents/Frameworks/) — no Homebrew required.
#   - If it's being run straight from a git checkout (Frameworks/ is a
#     build artifact, not committed), fall back to Homebrew Python for
#     local development/testing.
#

BUNDLE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
BOOTSTRAP="$BUNDLE_DIR/Contents/Resources/bootstrap.py"
FRAMEWORK_PY="$BUNDLE_DIR/Contents/Frameworks/Python.framework/Versions/Current/bin/python3"

if [ -x "$FRAMEWORK_PY" ]; then
    exec "$FRAMEWORK_PY" "$BOOTSTRAP" "$BUNDLE_DIR"
fi

# ── Dev fallback (no bundled Python.framework) ──────────────────────────────
DEV_PYTHON=""
for cand in \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12; do
    if [ -x "$cand" ] && "$cand" -c "import tkinter" 2>/dev/null; then
        DEV_PYTHON="$cand"
        break
    fi
done

if [ -z "$DEV_PYTHON" ]; then
    osascript -e 'display dialog "Whisper Transcriber needs either:\n\n  • A DMG built with build-dmg.sh (bundles its own Python), or\n  • Homebrew Python for local development:\n      brew install python-tk" with title "Whisper Transcriber — Setup Required" buttons {"OK"} default button "OK" with icon caution'
    exit 1
fi

exec "$DEV_PYTHON" "$BOOTSTRAP" "$BUNDLE_DIR"
